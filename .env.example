# Option A: Amazon Bedrock API key (bearer token). Simplest for a demo.
AWS_BEARER_TOKEN_BEDROCK=
# Option B: leave the key unset and use IAM (instance role, `aws sso login`, or env access keys).
AWS_REGION=us-east-1

# auto | live | mock. auto = live when AWS credentials are found, otherwise mock.
BEDROCK_MODE=auto

# Model per agent role (Bedrock model ids or cross-region inference profiles).
BEDROCK_MODEL_PLANNER=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL_CODER=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL_REVIEWER=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_FAST=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Optional Bedrock Guardrail applied to every call.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# Optional: require clients to send this key (x-api-key or Authorization: Bearer).
GATEWAY_API_KEY=
# Where customer Bedrock API keys live: local (demo, in-memory) or agentcore (AgentCore Identity).
CREDENTIAL_VAULT=local
AGENTCORE_WORKLOAD_NAME=devin-agent
# Run agent sessions on AgentCore Runtime instead of in-process.
AGENTCORE_RUNTIME_ARN=
# Override Devin-managed fallbacks: {"coder": ["global.anthropic...", "us.amazon.nova-pro-v1:0"]}
BEDROCK_FALLBACKS_JSON=
# Mock only: model ids that return ThrottlingException, to show a fallback offline.
MOCK_UNAVAILABLE_MODELS=
# Optional: append every metered call to a JSONL file.
LEDGER_PATH=

# Illustrative ACU economics (see docs/economics.md).
ACU_PRICE_USD=2.25
AWS_COGS_PER_ACU_USD=0.90
AWS_REVENUE_SHARE=0.20
RUNTIME_USD_PER_HOUR=0.40
OTHER_AWS_PCT_OF_INFRA=0.10
