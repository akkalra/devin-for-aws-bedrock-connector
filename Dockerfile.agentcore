# Agent container for Amazon Bedrock AgentCore Runtime (requires linux/arm64).
#   docker buildx build --platform linux/arm64 -f Dockerfile.agentcore -t <ecr-repo>:latest --push .
FROM --platform=linux/arm64 public.ecr.aws/docker/library/python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml README.md ./
COPY bedrock_connector ./bedrock_connector
COPY examples ./examples
RUN pip install --no-cache-dir -e ".[agentcore]" pytest
ENV BEDROCK_MODE=live CREDENTIAL_VAULT=agentcore AGENT_WORKDIR=/tmp/runs
EXPOSE 8080
CMD ["python", "-m", "bedrock_connector.agentcore_app"]
